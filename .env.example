# Slopesque — configuration. Copy to .env (git-ignored) to change a value; without .env, `pnpm dev` uses this file.
# Values starting with "dev-only-" are for local development only: the server refuses them in production.
# Never put a real secret in this file (the repository is public).

# ---- server
NODE_ENV=development
PORT=3100
# where the server is reached (the extension's « Serveur » setting); http allowed only for localhost or ALLOW_INSECURE
PUBLIC_URL=http://localhost:3100
LOG_LEVEL=info
# extension origins allowed on the WebSocket (comma-separated, e.g. chrome-extension://<id>); empty = any (dev only)
ALLOWED_ORIGINS=
# production without TLS (no domain yet): the panel shows « Connexion non chiffrée »
ALLOW_INSECURE=false
# behind a reverse proxy (production with Caddy): read the player's address from X-Forwarded-For
TRUST_PROXY=false

# ---- secrets (production: long random values, e.g. `openssl rand -base64 48`)
CODE_HMAC_SECRET=dev-only-code-hmac-secret

# ---- Postgres (infra/docker-compose.yml in development)
DATABASE_URL=postgres://slopesque:dev-only-postgres@localhost:55432/slopesque

# ---- Redis (cache, limits) — optional: without it the server runs with no cache
REDIS_URL=redis://localhost:56379

# ---- RustFS (S3 API) — optional: without it pictures are unavailable
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY=slopesque
S3_SECRET_KEY=dev-only-rustfs-secret
S3_BUCKET_DURABLE=slopesque-durable
S3_BUCKET_CHAT=slopesque-chat
# room for Postgres + RustFS on the machine (GB): warning at 90 %, uploads refused at 98 %
STORAGE_QUOTA_GB=50

# ---- external services — optional (see MANQUES.md): without a key, the GIF window says why
KLIPY_API_KEY=
GIPHY_API_KEY=

# ---- release, on your machine only (CI uses GitHub secrets of the « release » environment)
WEB_EXT_API_KEY=
WEB_EXT_API_SECRET=
CHROME_CRX_KEY_FILE=
