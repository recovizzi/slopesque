{
  "name": "slopesque",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "turbo run build",
    "check": "turbo run typecheck lint test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "doctor": "node tools/doctor.mjs",
    "admin": "pnpm --filter @slopesque/server admin",
    "db:migrate": "pnpm --filter @slopesque/server db:migrate",
    "db:generate": "pnpm --filter @slopesque/server db:generate",
    "services:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "services:down": "docker compose -f infra/docker-compose.yml down",
    "format": "prettier --write .",
    "prepare": "lefthook install 2>/dev/null || true",
    "e2e": "pnpm build && pnpm --filter @slopesque/e2e e2e",
    "stack:up": "node tools/stack.mjs up",
    "stack:down": "node tools/stack.mjs down",
    "stack:logs": "node tools/stack.mjs logs",
    "stack:admin": "docker compose -f infra/docker-compose.prod.yml --env-file infra/.env exec server admin",
    "e2e:stack": "E2E_STACK=1 pnpm --filter @slopesque/e2e e2e",
    "deploy:prod": "node tools/deploy.mjs",
    "prod:admin": "node tools/deploy.mjs admin",
    "tarot:duel": "pnpm --filter @slopesque/engines build && node packages/engines/tools/duel.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "globals": "^17.0.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
